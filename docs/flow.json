  "cards": [
    {
      "dot": "cyan",
      "title": "Capture",
      "items": [
        "The Mac records every copy, except ones marked private",
        "iOS hides the clipboard from apps, so the iPhone sends from Paste, Control Center or the share sheet"
      ]
    },
    {
      "dot": "emerald",
      "title": "Sync",
      "items": [
        "Each device sends the others the clips they're missing",
        "A clip from the last 2 minutes lands on the Mac's clipboard"
      ]
    },
    {
      "dot": "amber",
      "title": "Privacy",
      "items": [
        "Only devices paired with a 6-digit code can connect",
        "No Holt server and no account. A relay only sees encrypted bytes"
      ]
    }
