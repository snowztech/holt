  "cards": [
    {
      "dot": "cyan",
      "title": "Capture",
      "items": [
        "The Mac checks the clipboard twice a second and skips copies marked private",
        "iOS hides the clipboard in the background, so the iPhone sends from Paste, Control Center, Back Tap or the share sheet"
      ]
    },
    {
      "dot": "violet",
      "title": "Pairing",
      "items": [
        "Devices on the Mac shows a 6-digit code and a QR code, and advertises over Bonjour",
        "SPAKE2 checks the code without sending it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Sync",
      "items": [
        "Rows carry their origin device and a sequence number",
        "Sessions trade cursors, then send what the other side is missing, from every origin",
        "The newest update of a clip wins"
      ]
    },
    {
      "dot": "amber",
      "title": "Network",
      "items": [
        "Direct QUIC when a path exists",
        "n0 relays otherwise, still end-to-end encrypted"
      ]
    }
  ]
